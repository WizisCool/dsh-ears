{
  "name": "dsh-ears",
  "version": "0.5.0",
  "description": "Voice input and audio transcription for DeepSeek Harness, with local Whisper/SenseVoice, cloud ASR, and Agent transcript exports",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "author": "Pseudosalieri",
  "homepage": "https://github.com/Pseudosalieri/dsh-ears#readme",
  "bugs": {
    "url": "https://github.com/Pseudosalieri/dsh-ears/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "voice",
    "speech-to-text",
    "whisper",
    "asr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pseudosalieri/dsh-ears.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "assets",
    "locale/*.json"
  ],
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes/client",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "compat:smoke": "node scripts/compat-smoke.mjs",
    "use:platform": "node scripts/select-node-modules.mjs",
    "dev:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "node scripts/release-check.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "pnpm build && pnpm verify:package",
    "prepare:patch": "node scripts/create-dev-patch.mjs",
    "dev:config": "pnpm build && pnpm prepare:patch && dsh --profile web --dump-config --patch ./.dsh/cordis.patch.yml",
    "dev:web": "pnpm build && pnpm prepare:patch && dsh --profile web --patch ./.dsh/cordis.patch.yml"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@audio/decode-flac": "2.0.0",
    "@audio/decode-mp3": "1.3.1",
    "@audio/decode-opus": "1.3.3",
    "@audio/decode-vorbis": "1.3.4",
    "@audio/decode-wav": "2.0.0",
    "@audio/webm-decode": "1.0.0",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.4",
    "@fugood/whisper.node": "1.1.3",
    "immer": "^11.2.9",
    "sherpa-onnx-node": "2.0.1",
    "zod": "^4.4.3",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.4",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.4",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.4",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "@thesvg/react": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "tsdown": "^0.23.4",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
